# --- Next.js app (the implementation that powers this workspace's live preview) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: enables real OpenAI embeddings (text-embedding-3-small) and
# GPT-4o-mini function-calling for entity extraction / narrative polish.
# The app works fully offline/deterministically without this (TF-IDF +
# regex/rule-based extraction fallback), which is what the automated
# tests and the canonical wheat/semi-arid scenario rely on.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Reference standalone FastAPI backend (backend/, docker-compose.yml) ---
CHROMA_PATH=./chroma_db
